MYSQL_ROOT_PASSWORD=password
MYSQL_ROOT_HOST=%
MYSQL_DATABASE=resume-portal
MYSQL_USER=resume_user
MYSQL_PASSWORD=resume_password
MYSQL_PORT=6603
REDIS_PORT=6379
REDIS_HEALTH_ENABLED=true
APP_PORT=5000

SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FLYWAY_BASELINE_ON_MIGRATE=false
SQL_INIT_MODE=never
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
APP_SECURITY_REQUIRE_HTTPS=false
ALLOW_LEGACY_PLAIN_PASSWORDS=false
ACTUATOR_ADMIN_ROLE=ADMIN

PDF_EXPORT_MAX_OUTPUT_SIZE=10MB
PDF_EXPORT_MAX_PROFILE_CHARACTERS=50000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LOGIN_CAPACITY=20
RATE_LIMIT_PUBLIC_CAPACITY=300
RATE_LIMIT_PDF_CAPACITY=30
RATE_LIMIT_API_CAPACITY=600
